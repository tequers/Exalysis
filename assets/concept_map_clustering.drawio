<mxfile host="app.diagrams.net">
  <diagram name="Clustering and Mixture Models">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Central node -->
        <mxCell id="2" value="Clustering &amp; Mixture Models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a2e;strokeColor=#4a9eff;fontColor=#ffffff;fontSize=14;fontStyle=1;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="380" y="40" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- Shared: Unsupervised -->
        <mxCell id="3" value="Unsupervised&#xa;(no labels needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#4a9eff;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="140" width="220" height="50" as="geometry"/>
        </mxCell>

        <!-- Shared: Find representatives -->
        <mxCell id="4" value="Find cluster representatives&#xa;(move center to exact mean)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#4a9eff;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="240" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- Shared: Always converge -->
        <mxCell id="5" value="Always converge ✓&#xa;(but not to global optimum)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f3460;strokeColor=#4a9eff;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="390" y="340" width="240" height="50" as="geometry"/>
        </mxCell>

        <!-- k-Means node -->
        <mxCell id="6" value="k-Means&#xa;(needs k upfront)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#533483;strokeColor=#a78bfa;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="450" width="190" height="50" as="geometry"/>
        </mxCell>

        <!-- Mean Shift node -->
        <mxCell id="7" value="Mean Shift&#xa;(no k needed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a472a;strokeColor=#4ade80;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="730" y="450" width="190" height="50" as="geometry"/>
        </mxCell>

        <!-- k-Means: local minimum -->
        <mxCell id="8" value="Local minimum — Napoleon&#xa;(NP-hard to find global opt)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2066;strokeColor=#a78bfa;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- k-Means: spherical clusters -->
        <mxCell id="9" value="Assumes spherical clusters&#xa;(fails on dolphin shapes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d2066;strokeColor=#a78bfa;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="660" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- k-Means++ -->
        <mxCell id="10" value="k-Means++&#xa;(magnets: prob ∝ distance²&#xa;fixes bad init)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2d1b69;strokeColor=#a78bfa;fontColor=#ffffff;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="290" y="560" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- Mean Shift: density peaks -->
        <mxCell id="11" value="Finds density peaks&#xa;(arbitrary shapes ✓ — dolphin ok)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d2b1a;strokeColor=#4ade80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="560" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- Mean Shift: bandwidth sensitive -->
        <mxCell id="12" value="Bandwidth r sensitive + slow&#xa;(hippie with joint)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0d2b1a;strokeColor=#4ade80;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="730" y="660" width="230" height="50" as="geometry"/>
        </mxCell>

        <!-- Contrast node -->
        <mxCell id="13" value="Convergence target differs:&#xa;k-means → local minimum&#xa;Mean Shift → density peak&#xa;Neither finds global optimum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3d1520;strokeColor=#f87171;fontColor=#ffffff;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="390" y="660" width="240" height="70" as="geometry"/>
        </mxCell>

        <!-- EDGES -->
        <!-- Root → Unsupervised -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4a9eff;fontColor=#4a9eff;" edge="1" source="2" target="3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Unsupervised → Find reps -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4a9eff;" edge="1" source="3" target="4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Find reps → Converge -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4a9eff;" edge="1" source="4" target="5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Converge → k-Means -->
        <mxCell id="e4" value="k-Means" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#a78bfa;fontColor=#a78bfa;fontSize=10;" edge="1" source="5" target="6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Converge → Mean Shift -->
        <mxCell id="e5" value="Mean Shift" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4ade80;fontColor=#4ade80;fontSize=10;" edge="1" source="5" target="7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- k-Means → local min -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#a78bfa;" edge="1" source="6" target="8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- k-Means → spherical -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#a78bfa;" edge="1" source="6" target="9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- k-Means → k-Means++ -->
        <mxCell id="e8" value="fix for bad init" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#a78bfa;fontColor=#a78bfa;fontSize=10;dashed=1;" edge="1" source="6" target="10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Mean Shift → density peaks -->
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4ade80;" edge="1" source="7" target="11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- Mean Shift → bandwidth -->
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#4ade80;" edge="1" source="7" target="12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- local min → contrast -->
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f87171;dashed=1;" edge="1" source="8" target="13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <!-- density peaks → contrast -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#f87171;dashed=1;" edge="1" source="11" target="13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
