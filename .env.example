# Copy this file to .env. The real .env file is ignored by Git.
LLM_PROVIDER=unorouter
LLM_MODEL_STAGE1=glm-5.3-flash-search:free
LLM_MODEL_STAGE2=glm-5.3-flash-search:free
UNOROUTER_API_KEY=replace-with-your-key

# Request budgets, not model catalog facts. Set these to your models' limits.
# Context includes input, reserved output, and provider framing.
LLM_CONTEXT_TOKENS_STAGE1=128000
LLM_MAX_OUTPUT_TOKENS_STAGE1=32000
LLM_OVERHEAD_TOKENS_STAGE1=1024
LLM_CONTEXT_TOKENS_STAGE2=128000
LLM_MAX_OUTPUT_TOKENS_STAGE2=32000
LLM_OVERHEAD_TOKENS_STAGE2=1024
